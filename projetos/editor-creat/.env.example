# Editor creat.MTT — nomes das variáveis (NUNCA coloque valores reais neste arquivo nem no git).
# Provedor pago sem chave = desligado; o motor usa o local.

# --- dados e armazenamento
EDITOR_DADOS=
EDITOR_ARMAZENAMENTO=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_BUCKET=
# entregas: filme aprovado vai para a página de entregas (mesma do script da creat-nuvem). Sem as duas, desligado.
# R2_ENTREGAS_BUCKET=creat-entregas (público). Se for igual a R2_BACKUP_BUCKET, R2_BUCKET ou R2_MIDIA_BUCKET, as entregas
# ficam desligadas (a página é pública; backup e material nunca podem aparecer nela).
# R2_ENTREGAS_PUBLICO=https://pub-<id>.r2.dev (endereço público do creat-entregas, sem barra no fim)
R2_ENTREGAS_BUCKET=
R2_ENTREGAS_PUBLICO=
# espelho do material enviado no R2: DESLIGADO (custa saída do Railway). Liga só com o "pode" do dono.
# O teto conta só o espelho; os 10 GB grátis são da conta inteira (entregas + backup também). Por isso 4 GB.
EDITOR_ESPELHO=0
R2_MIDIA_BUCKET=
EDITOR_ESPELHO_TETO_GB=4

# --- leitura (transcrição e visão)
EDITOR_TRANSCRICAO=faster-whisper
EDITOR_WHISPER_MODELO=small
ELEVENLABS_API_KEY=
EDITOR_VISAO=local
GEMINI_API_KEY=
# opcionais da leitura (frente A); vazio = padrão
EDITOR_WHISPER_BEAM=1
EDITOR_WHISPER_TEMPERATURAS=0
EDITOR_WHISPER_DICAS=
EDITOR_PARAKEET_DIR=
EDITOR_PARAKEET_JANELA=20
EDITOR_SCRIBE_MODELO=scribe_v1
EDITOR_GEMINI_MODELO=gemini-3.5-flash-lite
EDITOR_YUNET=
EDITOR_HAAR=
EDITOR_MODELOS_BAIXAR=1
EDITOR_TREMOR_LIMITE_PX=40

# --- cérebro (Claude)
EDITOR_CEREBRO=fixture
# só teste/demonstração: EDL pronto como resposta do cérebro fixture (e corte do começo, em s)
EDITOR_CEREBRO_EDL=
EDITOR_CEREBRO_EDL_ATE=
EDITOR_ANTHROPIC_KEY=
ANTHROPIC_API_KEY=
EDITOR_MODELO_DIRECAO=claude-opus-5-5
EDITOR_MODELO_LEVE=claude-haiku-5-5
EDITOR_ESFORCO_DIRECAO=high
EDITOR_ORCAMENTO_ENTRADA=15000
EDITOR_ORCAMENTO_SAIDA=4000
# --- conversa com o editor (docs/plano-conversa-25-11.md, 13.6). Nenhum segredo novo: usa a mesma chave do cérebro.
# auto = ligada quando há chave do cérebro (a chave da tela liga e desliga); 0 = desligada no servidor (a tela não religa)
EDITOR_CONVERSA=auto
# anthropic (padrão) | falso = cérebro roteirizado, sem rede (testes e aceite do site). Ignorado com EDITOR_AMBIENTE=producao
EDITOR_CONVERSA_CEREBRO=anthropic
# producao = o deploy (deploy/iniciar.sh já exporta); trava o cérebro falso da conversa fora
EDITOR_AMBIENTE=
EDITOR_MODELO_CONVERSA=claude-opus-5-5
# low | medium | high
EDITOR_CONVERSA_ESFORCO=medium
# teto do dia em US$ (dia da Bahia, só a conversa). Só baixa: acima de 3.00 vale 3.00 (decisão do dono, 25/11)
EDITOR_CONVERSA_TETO_USD_DIA=3.00
# teto de memória REAL (MB residentes) do subprocesso que ouve o áudio do dono, vigiado pela API; 0 desliga. Medido: 0,75 GB
EDITOR_VOZ_LIMITE_MB=2048
# 0 tira as notas de andamento (thinking display: updates) e a beta delas
EDITOR_CONVERSA_ANDAMENTO=1
# 0 faz o SSE ?v=2 servir o gerador antigo (volta atrás sem mexer no site)
EDITOR_SSE_NOVO=1
# 1 = o dono autorizou o teste pago (tests/test_b_pago.py); sem isso nada pago roda
EDITOR_AUTORIZADO_PAGO=
# memória da casa (padrão: memoria/ do repositório; os testes usam uma cópia)
EDITOR_MEMORIA=
# biblioteca de trilhas (padrão: $EDITOR_DADOS/biblioteca/trilhas.json; áudio fora do git)
EDITOR_TRILHAS=

# --- render
EDITOR_RENDER=cpu
EDITOR_RENDER_WORKERS=3
EDITOR_THREADS=2
EDITOR_NICE=5
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MK_SOM=
# frente C: RAM máxima do buffer de um plano antes de usar JPEG (MB); limite do cache de planos (MB)
EDITOR_PLANO_RAM_MB=1500
EDITOR_CACHE_PLANOS_MB=1200
# M6, banco de sons reais (Sonniss GDC no archive.org; sem chave, sem custo): 1 ligado | 0 desligado; sqlite do kit
# em desenvolvimento (vazio = a cópia do índice que vai no motor); teto de download por filme (MB); teto do cache (MB)
EDITOR_SONS_REAIS=1
EDITOR_SFX_BANCO=
EDITOR_SONS_REAIS_MB=150
EDITOR_CACHE_SONS_MB=2000
# kit: 0 = captura antiga por screenshot; caminho do chrome-headless-shell (vazio = acha o do Playwright)
MK_BF=
MK_CHROME=

# --- entrega e publicação
EDITOR_PUBLICACAO=nenhuma
METRICOOL_TOKEN=
META_ACCESS_TOKEN=

# --- site <-> motor
MOTOR_URL=http://127.0.0.1:8787
MOTOR_TOKEN=
# host em que o motor escuta; fora de 127.0.0.1 o motor recusa subir sem MOTOR_TOKEN
MOTOR_HOST=127.0.0.1
EDITOR_SENHA_HASH=
EDITOR_SEGREDO_SESSAO=
EDITOR_ENVIO_PARTE_MB=64
# só desenvolvimento (motor falso do site; gere senha e segredo com `cd apps/web && pnpm senha "..."`)
MOTOR_FALSO_PORTA=8788
MOTOR_FALSO_PASSO_MS=700

# Revisão com olho de IA antes de entregar (qa/olho_ia.py): 1 chamada por versão, ~US$ 0,10 a 0,20
EDITOR_REVISAO_IA=1
EDITOR_REVISAO_TETO_USD=0.30
EDITOR_MODELO_REVISAO=
