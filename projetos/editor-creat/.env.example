# Editor creat.MTT — nomes das variáveis (NUNCA coloque valores reais neste arquivo nem no git).
# Provedor pago sem chave = desligado; o motor usa o local.

# --- dados e armazenamento
EDITOR_DADOS=
EDITOR_ARMAZENAMENTO=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# opcional: endpoint S3 próprio (só testes); EDITOR_ENVIO_*: envio direto do navegador ao R2 (site)
R2_ENDPOINT=
EDITOR_ENVIO_PARTE_MB=64
EDITOR_ENVIO_MAX_GB=200
# banco: sqlite (padrão) ou postgres (Supabase: use a connection string do Transaction pooler, porta 6543)
EDITOR_BANCO=sqlite
DATABASE_URL=

# --- leitura (transcrição e visão)
EDITOR_TRANSCRICAO=faster-whisper
EDITOR_WHISPER_MODELO=small
ELEVENLABS_API_KEY=
EDITOR_VISAO=local
GEMINI_API_KEY=
# opcionais da leitura (frente A); vazio = padrão
EDITOR_WHISPER_BEAM=1
EDITOR_WHISPER_TEMPERATURAS=0
EDITOR_WHISPER_DICAS=
EDITOR_PARAKEET_DIR=
EDITOR_PARAKEET_JANELA=20
EDITOR_SCRIBE_MODELO=scribe_v1
EDITOR_GEMINI_MODELO=gemini-3.5-flash-lite
EDITOR_YUNET=
EDITOR_HAAR=
EDITOR_MODELOS_BAIXAR=1
EDITOR_TREMOR_LIMITE_PX=40

# --- cérebro (Claude)
EDITOR_CEREBRO=fixture
# só teste/demonstração: EDL pronto como resposta do cérebro fixture (e corte do começo, em s)
EDITOR_CEREBRO_EDL=
EDITOR_CEREBRO_EDL_ATE=
ANTHROPIC_API_KEY=
EDITOR_MODELO_DIRECAO=claude-opus-5-5
EDITOR_MODELO_LEVE=claude-haiku-5-5
EDITOR_ESFORCO_DIRECAO=high
EDITOR_ORCAMENTO_ENTRADA=15000
EDITOR_ORCAMENTO_SAIDA=4000
# 1 = o dono autorizou o teste pago (tests/test_b_pago.py); sem isso nada pago roda
EDITOR_AUTORIZADO_PAGO=
# memória da casa (padrão: memoria/ do repositório; os testes usam uma cópia)
EDITOR_MEMORIA=
# biblioteca de trilhas (padrão: $EDITOR_DADOS/biblioteca/trilhas.json; áudio fora do git)
EDITOR_TRILHAS=

# --- render
EDITOR_RENDER=cpu
EDITOR_RENDER_WORKERS=3
EDITOR_THREADS=2
EDITOR_NICE=5
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MK_SOM=
# frente C: RAM máxima do buffer de um plano antes de usar JPEG (MB); limite do cache de planos (MB)
EDITOR_PLANO_RAM_MB=1500
EDITOR_CACHE_PLANOS_MB=1200
# kit: 0 = captura antiga por screenshot; caminho do chrome-headless-shell (vazio = acha o do Playwright)
MK_BF=
MK_CHROME=

# --- entrega e publicação
EDITOR_PUBLICACAO=nenhuma
METRICOOL_TOKEN=
META_ACCESS_TOKEN=

# --- site <-> motor
MOTOR_URL=http://127.0.0.1:8787
MOTOR_TOKEN=
# host em que o motor escuta; fora de 127.0.0.1 o motor recusa subir sem MOTOR_TOKEN
MOTOR_HOST=127.0.0.1
EDITOR_SENHA_HASH=
EDITOR_SEGREDO_SESSAO=
# só desenvolvimento (motor falso do site; gere senha e segredo com `cd apps/web && pnpm senha "..."`)
MOTOR_FALSO_PORTA=8788
MOTOR_FALSO_PASSO_MS=700

# --- login do site (Vercel). EDITOR_AUTH=senha (padrão) | supabase
EDITOR_AUTH=senha
SUPABASE_URL=
SUPABASE_ANON_KEY=
# opcional: sem ela o site valida o login pelo JWKS do Supabase
SUPABASE_JWT_SECRET=
# obrigatória no modo supabase: e-mails liberados, separados por vírgula
EDITOR_EMAILS_PERMITIDOS=

# --- falante (rótulo Marcos/Ruan/Xande): desligado | voz | fixture
EDITOR_FALANTE=voz
EDITOR_FALANTES_DIR=
EDITOR_FALANTE_MODELO=
EDITOR_FALANTE_MARGEM=0.2
EDITOR_FALANTE_LIMIAR=2.5
EDITOR_FALANTE_LIMIAR_COS=0.5

# --- Modal / GPU / conferência (ver DEPLOY.md)
EDITOR_SEM_ESTADO=
EDITOR_MODAL_WORKER=
EDITOR_MODAL_WORKER_INTERVALO=15
EDITOR_GPU_LIMITE_S=120
EDITOR_GPU_VIA=
EDITOR_GPU_BYTES_MAX_MB=1024
EDITOR_GPU_WORKERS=
EDITOR_CONFERIR_TIMEOUT_S=8
# site (Vercel): duração de cada conexão SSE
MOTOR_SSE_JANELA_S=240
