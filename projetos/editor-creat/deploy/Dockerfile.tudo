# Editor creat.MTT em UM contêiner (site + motor + worker), para hospedagens que dão um endereço pronto (Railway, Render).
# O site escuta em $PORT (a hospedagem define); o motor fica só em 127.0.0.1. Dados em /dados (monte um volume aí).
FROM mcr.microsoft.com/playwright:v1.63.0-noble
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* && corepack enable
WORKDIR /app/projetos/editor-creat
COPY packages ./packages
COPY memoria ./memoria
COPY services/motor ./services/motor
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -e "./services/motor[transcricao,cerebro,r2]"
RUN cd packages/kit && npm install --omit=dev --no-audit --no-fund && npm install --no-save --no-audit --no-fund playwright@1.63.0
COPY apps/web ./apps/web
RUN cd apps/web && pnpm install --frozen-lockfile && pnpm build
COPY deploy/iniciar.sh /usr/local/bin/iniciar.sh
RUN chmod +x /usr/local/bin/iniciar.sh
ENV PATH=/opt/venv/bin:$PATH EDITOR_DADOS=/dados MOTOR_URL=http://127.0.0.1:8787 NODE_ENV=production
EXPOSE 3000
CMD ["/usr/local/bin/iniciar.sh"]
