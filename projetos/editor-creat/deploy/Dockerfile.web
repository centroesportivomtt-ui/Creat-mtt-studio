# Site do Editor creat.MTT (Next.js). Fala com o motor pela rede interna; o token do motor nunca vai ao navegador.
FROM node:22-bookworm-slim AS build
WORKDIR /web
RUN corepack enable
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web ./
RUN pnpm build

FROM node:22-bookworm-slim
WORKDIR /web
RUN corepack enable
ENV NODE_ENV=production
COPY --from=build /web ./
EXPOSE 3000
CMD ["pnpm", "start"]
