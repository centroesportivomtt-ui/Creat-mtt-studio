# Copie para .env no servidor e preencha. Os valores secretos ficam só no servidor.
EDITOR_DOMINIO=editor.seudominio.com.br
# site: senha da casa (gere com: cd apps/web && pnpm senha) e segredo da sessão (texto aleatório longo)
EDITOR_SENHA_HASH=
EDITOR_SEGREDO_SESSAO=
# motor <-> site: token interno (texto aleatório longo, igual nos dois)
MOTOR_TOKEN=
# cérebro: anthropic quando houver chave; sem chave o motor cai no fixture
EDITOR_CEREBRO=anthropic
EDITOR_ANTHROPIC_KEY=
EDITOR_MODELO_DIRECAO=claude-opus-5-5
EDITOR_ESFORCO_DIRECAO=high
# conversa com o editor: ligada por padrão com a chave do cérebro; 0 desliga no servidor. Teto travado em US$ 3/dia (só baixa)
EDITOR_CONVERSA=auto
EDITOR_CONVERSA_TETO_USD_DIA=3.00
# armazenamento: local (disco do servidor) ou r2 (Cloudflare R2)
EDITOR_ARMAZENAMENTO=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# transcrição local (sem custo)
EDITOR_TRANSCRICAO=faster-whisper
EDITOR_WHISPER_MODELO=small
EDITOR_RENDER=cpu
EDITOR_RENDER_WORKERS=3
