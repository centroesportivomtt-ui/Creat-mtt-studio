{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatmtt.local/schemas/direcao.schema.json",
  "title": "Direção (saída do cérebro)",
  "description": "A ÚNICA coisa que o Claude escreve por vídeo: decisões, por id do catálogo, sem tempos de quadro, sem palavras de legenda, sem código. O resolvedor (motor/etapas/resolvedor.py) expande isto no EDL de montagem. Meta: <= 4 000 tokens de saída. Usado como output_config.format (structured outputs) na API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "tipo_video",
    "modelo",
    "duracao_alvo",
    "conceito",
    "blocos",
    "trilha",
    "fecho"
  ],
  "properties": {
    "versao": {
      "const": "1"
    },
    "tipo_video": {
      "enum": [
        "evento",
        "empresa",
        "daily_vlog",
        "anuncio",
        "depoimento",
        "bastidor"
      ]
    },
    "modelo": {
      "type": "string",
      "description": "Modelo de vídeo (template) do catálogo."
    },
    "duracao_alvo": {
      "type": "number",
      "minimum": 5,
      "maximum": 600
    },
    "sem_fala": {
      "type": "boolean",
      "description": "Filme SEM fala, cortado pela música (viagem, natureza, evento sem depoimento): blocos com falas vazias; a cobertura do bloco é opcional (vazia = o editor escolhe os melhores trechos em ordem de gravação). O editor põe a virada da música no bloco de trilha.drop_em, corta na batida pela energia de cada parte da música e usa a trilha cheia. Sem o campo, o modo liga sozinho quando nenhum bloco tem fala; false força o resolvedor com fala."
    },
    "vel_fala": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 1.25,
      "default": 1.1,
      "description": "Aceleração da fala (1,08 a 1,15 normalmente)."
    },
    "conceito": {
      "type": "string",
      "maxLength": 300,
      "description": "A ideia do vídeo em uma frase (o 'pulo do gato')."
    },
    "alem_do_pedido": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "O que a direção faz a mais do que foi pedido."
    },
    "gancho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto_tela"
      ],
      "properties": {
        "texto_tela": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "maxItems": 4
        },
        "troca": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "risca": {
              "type": "string"
            },
            "para": {
              "type": "string"
            }
          }
        },
        "atras_da_pessoa": {
          "type": "boolean",
          "description": "O título do gancho fica ATRÁS de quem fala (a pessoa passa na frente do texto). Use quando o gancho abre com a pessoa em quadro, de frente, e o texto é grande."
        }
      }
    },
    "blocos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "funcao",
          "intensidade",
          "falas",
          "cobertura",
          "saida"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B[0-9]{1,2}$"
          },
          "funcao": {
            "enum": [
              "gancho",
              "contexto",
              "prova",
              "bastidor",
              "virada",
              "climax",
              "emocao",
              "oferta",
              "convite"
            ]
          },
          "intensidade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "falas": {
            "type": "array",
            "description": "Falas na ordem em que entram. 'de'/'ate' = primeiras/últimas palavras do trecho (o resolvedor acha os tempos por palavra).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^F[0-9]{2,3}\\.[0-9]+$"
                },
                "de": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 60
                },
                "ate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 60
                },
                "corrigir": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 6,
                  "description": "Correções de legenda confirmadas, em pares: [{'de': 'voando a', 'para': 'Ruan na'}]. 'de' = palavras como a transcrição escreveu (uma ou mais); 'para' = o que foi dito de fato. Vale só dentro desta fala.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "de",
                      "para"
                    ],
                    "properties": {
                      "de": {
                        "type": "string",
                        "maxLength": 60
                      },
                      "para": {
                        "type": "string",
                        "maxLength": 60
                      }
                    }
                  }
                },
                "imagem": {
                  "enum": [
                    "falante",
                    "cobertura",
                    "misto"
                  ],
                  "default": "misto"
                }
              }
            }
          },
          "cobertura": {
            "type": "array",
            "description": "B-roll por momento do catálogo.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "m"
              ],
              "properties": {
                "m": {
                  "type": "string",
                  "pattern": "^M[0-9]{2,3}\\.[0-9]+$"
                },
                "sobre": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Id da fala sob a qual entra (null = entre falas / na música)."
                },
                "dur": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0.3,
                  "maximum": 8
                },
                "efeito": {
                  "enum": [
                    "nenhum",
                    "punch",
                    "lento",
                    "rampa",
                    "congela",
                    "janela",
                    "atras"
                  ],
                  "default": "nenhum"
                }
              }
            }
          },
          "texto_tela": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "chips": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nome"
              ],
              "properties": {
                "nome": {
                  "type": "string",
                  "maxLength": 40
                },
                "funcao": {
                  "type": "string",
                  "maxLength": 50
                },
                "sobre": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "saida": {
            "enum": [
              "corte_batida",
              "whip",
              "mascara",
              "aba71",
              "impacto",
              "match",
              "flash",
              "fade"
            ]
          },
          "fundo_desfocado": {
            "type": "boolean",
            "description": "Desfoca o fundo atrás da pessoa nos planos de fala deste bloco (fundo poluído de loja; o foco vai para quem fala)."
          },
          "destaque_pessoa": {
            "type": "boolean",
            "description": "Janela de luz em quem fala neste bloco: o fundo escurece um pouco e perde cor, a pessoa salta da loja sem desfocar o fundo."
          }
        }
      }
    },
    "trilha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clima"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "clima": {
          "type": "string",
          "maxLength": 80
        },
        "curva": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "description": "Intensidade por bloco (curva emocional de verdade, não loop)."
        },
        "drop_em": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id do bloco onde a música explode."
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "Opcional: 2 ou 3 trilhas da biblioteca em sequência (a 1a é a principal). O editor troca no fim de uma parte, no 1 do compasso, casando tom e tempo."
        },
        "troca_em": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          },
          "description": "Opcional: id do bloco em que cada música seguinte assume (sem isso, o filme se divide por igual)."
        }
      }
    },
    "fecho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cta"
      ],
      "properties": {
        "cta": {
          "type": "string",
          "maxLength": 40
        },
        "apoio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "arroba": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo_cliente": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chave da marca em memoria/marcas (nunca logo de baixa resolução)."
        }
      }
    },
    "riscos": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "Dúvidas que o QA deve checar (palavra incerta, rosto de terceiro, tela legível)."
    }
  }
}
