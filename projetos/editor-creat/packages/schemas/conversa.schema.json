    }
   }
  },
  "ev_turno_fim": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "projeto",
    "ts",
    "tipo",
    "dados"
   ],
   "properties": {
    "id": {
     "type": "integer"
    },
    "projeto": {
     "type": "string"
    },
    "ts": {
     "type": "string"
    },
    "tipo": {
     "const": "turno_fim"
    },
