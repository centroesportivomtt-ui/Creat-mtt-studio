{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creat-nuvem:schema:tenant:v1",
  "title": "TenantConfig v1",
  "description": "Dados de um site do Porta Aberta (v1.3: campos opcionais fuso, galeria e recados, ADR-006). O motor v1 lê window.TENANT com este formato (ADR-001). Qualquer chave fora desta lista é rejeitada, inclusive demo.ocupacaoFicticia. Regras que o JSON Schema não expressa (fecha > abre, termos proibidos, chaves de textos fora da lista do preset, frase 'o dono confirma pelo WhatsApp') ficam em scripts/producao/validar-tenant.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "slug", "nicho", "negocio", "pagina", "funcionamento", "servicos", "avaliacoes", "cores", "agendamento", "textos", "meta"],
  "properties": {
    "versao": { "const": 1 },
    "slug": { "$ref": "#/$defs/slug" },
    "nicho": { "$ref": "#/$defs/nicho" },
    "negocio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "nomeCurto", "bordao"],
      "properties": {
        "nome": { "$ref": "#/$defs/nomeNegocio" },
        "nomeCurto": { "type": "string", "minLength": 1, "maxLength": 28, "pattern": "^[\\p{L}\\p{N} &.'-]+$" },
        "bordao": { "type": "string", "minLength": 1, "maxLength": 90 },
        "whatsapp": { "$ref": "#/$defs/whatsapp" },
        "telefoneExibicao": { "type": "string", "pattern": "^[0-9 ()+-]{8,20}$" },
        "endereco": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidade"],
          "properties": {
            "rua": { "type": "string", "minLength": 1, "maxLength": 80 },
            "numero": { "type": "string", "minLength": 1, "maxLength": 12 },
            "bairro": { "type": "string", "minLength": 1, "maxLength": 60 },
            "cidade": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[\\p{L}\\p{N} .'-]+$" },
            "uf": { "enum": ["AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"] },
            "cep": { "type": "string", "pattern": "^[0-9]{5}-?[0-9]{3}$" }
          }
        },
        "instagram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usuario", "url"],
          "properties": {
            "usuario": { "type": "string", "pattern": "^@[A-Za-z0-9._]{1,30}$" },
            "url": { "type": "string", "pattern": "^https://(www\\.)?instagram\\.com/[A-Za-z0-9._]{1,30}/?$" }
          }
        }
      }
    },
    "pagina": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "descricao"],
      "properties": {
        "titulo": { "type": "string", "minLength": 1, "maxLength": 70 },
        "descricao": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "funcionamento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passoMin", "antecedenciaMin", "diasNaFita", "semana"],
      "properties": {
        "passoMin": { "type": "integer", "minimum": 5, "maximum": 120, "multipleOf": 5 },
        "antecedenciaMin": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "diasNaFita": { "type": "integer", "minimum": 1, "maximum": 14 },
        "semana": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3", "4", "5", "6"],
          "properties": {
            "0": { "$ref": "#/$defs/dia" },
            "1": { "$ref": "#/$defs/dia" },
            "2": { "$ref": "#/$defs/dia" },
            "3": { "$ref": "#/$defs/dia" },
            "4": { "$ref": "#/$defs/dia" },
            "5": { "$ref": "#/$defs/dia" },
            "6": { "$ref": "#/$defs/dia" }
          }
        }
      }
    },
    "servicos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "preco", "duracaoMin", "descricao"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$" },
          "nome": { "type": "string", "minLength": 1, "maxLength": 50 },
          "preco": { "oneOf": [ { "type": "number", "minimum": 0, "maximum": 100000 }, { "type": "null" } ] },
          "duracaoMin": { "type": "integer", "minimum": 5, "maximum": 600 },
          "descricao": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "profissionais": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "especialidade", "bio"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$" },
          "nome": { "type": "string", "minLength": 1, "maxLength": 40 },
          "especialidade": { "type": "string", "minLength": 1, "maxLength": 30 },
          "bio": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "avaliacoes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["texto", "autor", "origem", "aprovadoEm"],
        "properties": {
          "texto": { "type": "string", "minLength": 1, "maxLength": 280 },
          "autor": { "type": "string", "minLength": 1, "maxLength": 40 },
          "origem": { "enum": ["dono", "cliente_autorizado"] },
          "aprovadoEm": { "$ref": "#/$defs/dataHora" }
        }
      }
    },
    "cores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fundo", "texto", "destaque", "apoio"],
      "properties": {
        "fundo": { "$ref": "#/$defs/cor" },
        "texto": { "$ref": "#/$defs/cor" },
        "destaque": { "$ref": "#/$defs/cor" },
        "apoio": { "$ref": "#/$defs/cor" }
      }
    },
    "agendamento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modo"],
      "properties": {
        "modo": { "enum": ["whatsapp", "link_externo"] },
        "urlExterna": { "type": "string", "maxLength": 300, "pattern": "^https://[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(/[^\\s<>\"']*)?$" },
        "mensagem": { "type": "string", "minLength": 1, "maxLength": 400 }
      },
      "if": { "properties": { "modo": { "const": "link_externo" } } },
      "then": { "required": ["urlExterna"] },
      "else": { "not": { "required": ["urlExterna"] } }
    },
    "textos": {
      "description": "União das listas brancas dos presets. Cada preset declara o subconjunto que aceita (motor/nichos/<nicho>.js, campo textosPermitidos); validar-tenant.mjs rejeita chave fora do subconjunto. Marcadores aceitos: {nome} {cidade} {dia} {hora} {servico} {profissional}.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heroTitulo": { "$ref": "#/$defs/textoCurto" },
        "heroSubtitulo": { "$ref": "#/$defs/textoMedio" },
        "manifesto": { "$ref": "#/$defs/textoLongo" },
        "servicosTitulo": { "$ref": "#/$defs/textoCurto" },
        "servicosNota": { "$ref": "#/$defs/textoMedio" },
        "equipeTitulo": { "$ref": "#/$defs/textoCurto" },
        "avaliacoesTitulo": { "$ref": "#/$defs/textoCurto" },
        "pedidoTitulo": { "$ref": "#/$defs/textoCurto" },
        "pedidoNota": { "$ref": "#/$defs/textoMedio" },
        "ritualDica": { "$ref": "#/$defs/textoCurto" },
        "confirmacaoTitulo": { "$ref": "#/$defs/textoCurto" },
        "confirmacaoTexto": { "$ref": "#/$defs/textoMedio" },
        "letreiroAberto": { "$ref": "#/$defs/textoCurto" },
        "letreiroFechado": { "$ref": "#/$defs/textoCurto" },
        "localTitulo": { "$ref": "#/$defs/textoCurto" },
        "faqTitulo": { "$ref": "#/$defs/textoCurto" },
        "faq": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pergunta", "resposta"],
            "properties": {
              "pergunta": { "type": "string", "minLength": 1, "maxLength": 120 },
              "resposta": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        },
        "rodapeFrase": { "$ref": "#/$defs/textoMedio" }
      }
    },
    "fuso": {
      "description": "v1.3 (opcional): fuso do negócio para 'aberto agora', 'hoje' e horários livres. Sem ele, o motor usa o fuso da UF do endereço e, sem UF, America/Bahia (ADR-006).",
      "enum": ["America/Noronha", "America/Belem", "America/Fortaleza", "America/Recife", "America/Araguaina", "America/Maceio", "America/Bahia", "America/Sao_Paulo", "America/Campo_Grande", "America/Cuiaba", "America/Santarem", "America/Porto_Velho", "America/Boa_Vista", "America/Manaus", "America/Eirunepe", "America/Rio_Branco"]
    },
    "galeria": {
      "description": "v1.3 (opcional): fotos do site, só da pasta galeria/ do próprio site (nenhuma imagem de terceiro em tempo de execução). O motor mostra a seção 'Trabalhos da casa' com 3 fotos ou mais; na demonstração, cada uma é rotulada 'Foto de exemplo'. Sem galeria, a seção não existe (ADR-006).",
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt", "legenda"],
        "properties": {
          "src": { "type": "string", "pattern": "^galeria/[a-z0-9][a-z0-9-]{0,60}\\.(webp|avif|jpg|jpeg|png)$" },
          "alt": { "type": "string", "minLength": 1, "maxLength": 160 },
          "legenda": { "type": "string", "minLength": 1, "maxLength": 90 },
          "credito": { "type": "string", "minLength": 1, "maxLength": 80 },
          "largura": { "type": "integer", "minimum": 16, "maximum": 4000 },
          "altura": { "type": "integer", "minimum": 16, "maximum": 4000 }
        }
      }
    },
    "recados": {
      "description": "v1.3 (opcional): recados DE EXEMPLO, só em site-demonstração (slug demo-*); o motor só os mostra com demonstracao:true e com selo. Depoimento de cliente real continua em avaliacoes[], com origem e aprovadoEm (ADR-006).",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["texto", "autor"],
        "properties": {
          "texto": { "type": "string", "minLength": 1, "maxLength": 200 },
          "autor": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previa", "motorVersao", "criadoEm"],
      "properties": {
        "previa": { "type": "boolean" },
        "motorVersao": { "type": "string", "pattern": "^v1(\\.[0-9]+){0,2}$" },
        "criadoEm": { "$ref": "#/$defs/dataHora" }
      }
    }
  },
  "allOf": [
    {
      "description": "Prévia: sem equipe e sem avaliação (regra dura 1); WhatsApp do negócio não é conhecido.",
      "if": { "properties": { "meta": { "properties": { "previa": { "const": true } } } } },
      "then": {
        "properties": {
          "avaliacoes": { "maxItems": 0 },
          "profissionais": { "maxItems": 0 },
          "negocio": { "not": { "required": ["whatsapp"] } }
        }
      }
    },
    {
      "description": "Site entregue: WhatsApp e endereço completo obrigatórios.",
      "if": { "properties": { "meta": { "properties": { "previa": { "const": false } } } } },
      "then": {
        "properties": {
          "negocio": {
            "required": ["whatsapp", "telefoneExibicao", "endereco"],
            "properties": { "endereco": { "required": ["rua", "numero", "bairro", "cidade", "uf", "cep"] } }
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])$" },
    "nicho": { "enum": ["barbearia", "salao", "academia"] },
    "nomeNegocio": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[\\p{L}\\p{N} &.'-]+$" },
    "whatsapp": {
      "type": "string",
      "pattern": "^55\\d{2}\\d{8,9}$",
      "allOf": [ { "not": { "const": "5500000000000" } }, { "not": { "pattern": "^5500" } } ]
    },
    "dia": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["abre", "fecha"],
          "properties": {
            "abre": { "$ref": "#/$defs/hora" },
            "fecha": { "$ref": "#/$defs/hora" }
          }
        }
      ]
    },
    "hora": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "cor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "dataHora": { "type": "string", "format": "date-time" },
    "textoCurto": { "type": "string", "minLength": 1, "maxLength": 60 },
    "textoMedio": { "type": "string", "minLength": 1, "maxLength": 200 },
    "textoLongo": { "type": "string", "minLength": 1, "maxLength": 600 }
  }
}
