# Porta Aberta · variáveis de ambiente (copie para .env, que fica fora do git)
# Nunca coloque valores neste arquivo. Na nuvem, use o cofre do provedor.

# Produção v0 (scripts/producao/produzir.mjs): chave do Claude Console (Commercial Terms),
# nunca a assinatura Pro. console.anthropic.com > Settings > API Keys
ANTHROPIC_API_KEY=

# Modelo da produção (vazio = padrão do produzir.mjs, o Sonnet vigente)
CREAT_MODELO=

# Câmbio R$ por US$ usado no custo.json (ex.: 5.50; obrigatório quando a IA roda de verdade)
CREAT_CAMBIO=

# Deploy (wrangler). Token com permissão "Workers Scripts:Edit" só da conta da Creat.
# dash.cloudflare.com > My Profile > API Tokens > Create Token > "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=

# ---- opcionais da produção v0 (sem segredo; vazio = comportamento padrão) ----
# Home da vitrine, para o link do rodapé "Aberto pela Creat".
# Vazio = https://creat-nuvem-404b1994.base44.app/ (app Base44 "Creat Nuvem"); "0" = rodapé sem link.
CREAT_HOME=
# URL dos sites entregues, com {slug}. Vazio = https://creat-nuvem-404b1994.base44.app/sites/{slug}/
# (onde scripts/producao/publicar-site.cjs os coloca: public/sites/<slug>/ do app).
# Com domínio próprio: https://{slug}.<dominio>/ ; "0" = sem canonical nem sitemap.
CREAT_URL_SITES=
# Caminho da função de aprovação do rascunho, na mesma origem do rascunho (o botão "Aprovar" chama).
# Fica comentada: o padrão do produzir.mjs já é /api/pa/aprovarRascunho, onde o 1A publica a função.
# Só descomente se a função mudar de caminho; precisa começar com "/" (nada de domínio, nada de "?").
# Confira no rascunho gerado: grep -o 'data-endpoint="[^"]*"' dist/<slug>-r-<id>/index.html
# CREAT_APROVAR_URL=
# Domínios da Creat que o zip do SAIR não pode citar, separados por vírgula
CREAT_DOMINIOS=
# "0" desliga o modelo reserva quando o principal falha (vazio = reserva ligada)
CREAT_FALLBACK=
# Pasta de saída da produção (vazio = padrão do script)
CREAT_SAIDA=
# Pasta onde publicar-site.cjs grava site-<slug>.zip (vazio = scratchpad da sessão, ou <tmp>/creat-publicar)
CREAT_PUBLICAR_DESTINO=
# Caminho de fixture da IA (testes sem rede; vazio = chamada real)
CREAT_IA_FIXTURE=
