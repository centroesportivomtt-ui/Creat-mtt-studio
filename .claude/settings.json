{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/modo-linha.txt\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(cat); case \"$d\" in *leitor-pedido*|*redator-pedido*|*publicador-pedido*) printf '%s' \"$d\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/papeis.cjs\" pre ;; *) exit 0 ;; esac",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(cat); case \"$d\" in *leitor-pedido*|*redator-pedido*|*publicador-pedido*) printf '%s' \"$d\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/papeis.cjs\" post ;; *) exit 0 ;; esac",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(leitor|redator|publicador)-pedido$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/papeis.cjs\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
